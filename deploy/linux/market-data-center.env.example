# Install as /home/project/.env with mode 0600. Replace every
# placeholder locally; never commit the resulting file.
DATABASE_URL=postgresql+psycopg://<worker-role>:<password>@<host>:5432/<database>
RAW_DATA_ROOT=/var/lib/market-data-center/raw
SCHEDULER_STORE_PATH=/var/lib/market-data-center/scheduler/jobs.sqlite
PYTDX_DAILY_BAR_ENDPOINTS=<host1>:7709,<host2>:7709
PYTDX_DAILY_BAR_TIMEOUT_SECONDS=3
PYTDX_DAILY_BAR_MAX_ATTEMPTS=2
PYTDX_DAILY_BAR_PAGE_SIZE=800
PYTDX_DAILY_BAR_MAX_PAGES=16
TUSHARE_TOKEN=<server-only-token>
SCHEDULER_TIMEZONE=Asia/Shanghai
DAILY_RUN_HOUR=18
DAILY_RUN_MINUTE=30
STOCK_DAILY_INDICATOR_HOUR=19
STOCK_DAILY_INDICATOR_MINUTE=0
STOCK_POOL_HOUR=19
STOCK_POOL_MINUTE=30
DEDUCTED_PROFIT_HOUR=20
DEDUCTED_PROFIT_MINUTE=0
SCHEDULER_MISFIRE_GRACE_SECONDS=21600
WORKER_ADMIN_PORT=8765
AUCTION_COLLECTION_ENABLED=false
AUCTION_COLLECTION_HOUR=9
AUCTION_COLLECTION_MINUTE=15
AUCTION_COLLECTION_CADENCE_SECONDS=5
