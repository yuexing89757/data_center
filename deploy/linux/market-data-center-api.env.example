# Install as /etc/market-data-center/api.env, owned by root with mode 0600.
# This file is independent of /home/project/.env used by the Worker.
FASTAPI_DATABASE_URL='postgresql+psycopg://<api-login>:<password>@<postgres-host>:5432/<database>'
FASTAPI_API_KEY='<at-least-32-random-characters>'
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
# Shared protected Raw root for the two explicitly accepted live API fallbacks.
FASTAPI_AUCTION_RAW_ROOT=/var/lib/market-data-api/raw
FASTAPI_AUCTION_LIVE_TIMEOUT_SECONDS=5
FASTAPI_AUCTION_LIVE_MAX_ATTEMPTS=2
FASTAPI_AUCTION_LIVE_CACHE_SECONDS=3
FASTAPI_AUCTION_LIVE_MINIMUM_INTERVAL_SECONDS=1
