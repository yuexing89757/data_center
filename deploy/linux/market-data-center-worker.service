[Unit]
Description=Market Data Center collection worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=market-data-center
Group=market-data-center
WorkingDirectory=/home/project
EnvironmentFile=/home/project/.env
ExecStart=/home/project/.venv/bin/market-data-center worker
ExecStartPre=/usr/bin/test -r /home/project/.env
ExecStartPre=/usr/bin/test -d /var/lib/market-data-center/raw
ExecStartPre=/usr/bin/test -d /var/lib/market-data-center/scheduler
Restart=always
RestartSec=10
TimeoutStartSec=75
KillSignal=SIGTERM
TimeoutStopSec=300
StateDirectory=market-data-center
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/market-data-center

[Install]
WantedBy=multi-user.target
