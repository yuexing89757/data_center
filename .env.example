SUPABASE_URL=http://<supabase-api-gateway>
SUPABASE_PUBLISHABLE_KEY=<client-safe-key>
SUPABASE_SECRET_KEY=<server-only-secret>
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
MIGRATION_DATABASE_URL=postgresql://<migration-role>:<password>@<host>:<port>/<database>
RAW_DATA_ROOT=data/raw
PYTDX_VIPDOC_PATH=<tdx-installation>\vipdoc
TUSHARE_TOKEN=<server-only-tushare-token>
SCHEDULER_STORE_PATH=data/scheduler/jobs.sqlite
SCHEDULER_TIMEZONE=Asia/Shanghai
DAILY_RUN_HOUR=18
DAILY_RUN_MINUTE=30
STOCK_DAILY_INDICATOR_HOUR=19
STOCK_DAILY_INDICATOR_MINUTE=0
STOCK_POOL_HOUR=19
STOCK_POOL_MINUTE=30
DEDUCTED_PROFIT_HOUR=20
DEDUCTED_PROFIT_MINUTE=0
SCHEDULER_MISFIRE_GRACE_SECONDS=21600
WORKER_ADMIN_PORT=8765
