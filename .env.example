DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
MIGRATION_DATABASE_URL=postgresql://<migration-role>:<password>@<host>:<port>/<database>
FASTAPI_DATABASE_URL=postgresql+psycopg://<api-readonly-role>:<password>@<host>:<port>/<database>
FASTAPI_API_KEY=<at-least-32-random-characters>
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
RAW_DATA_ROOT=data/raw
DAILY_BAR_WRITE_BATCH_SIZE=100
PYTDX_POOL_PATH=data/pytdx_pool.json
PYTDX_VIPDOC_PATH=D:\new_tdx64\vipdoc
PYTDX_DAILY_BAR_TIMEOUT_SECONDS=3
PYTDX_DAILY_BAR_MAX_ATTEMPTS=2
PYTDX_DAILY_BAR_PAGE_SIZE=800
PYTDX_DAILY_BAR_MAX_PAGES=16
PYTDX_HQ_TIMEOUT_SECONDS=2
PYTDX_HQ_BATCH_SIZE=80
PYTDX_HQ_MAX_RETRIES=1
TUSHARE_TOKEN=<server-only-tushare-token>
SCHEDULER_STORE_PATH=data/scheduler/jobs.sqlite
WORKER_ADMIN_PORT=8765
# The controlled Worker catalog owns all task times. Environment configuration
# may only enable or disable these optional tasks.
AUCTION_COLLECTION_ENABLED=true
EOD_QUOTE_SNAPSHOT_ENABLED=true
CALL_AUCTION_SNAPSHOT_ENABLED=true
