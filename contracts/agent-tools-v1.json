      "endpoint": "query_auction_quotes",
      "read_only": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "p_trade_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "p_session_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "p_symbol": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(SSE|SZSE):[0-9]{6}$"
          },
          "p_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "p_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "p_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "default": 1000
          }
