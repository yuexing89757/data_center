  "paths": {
    "/api/v1/classifications/{namespace}/{classification_type}/{classification_code}/members": {
      "get": {
        "operationId": "classification_members_api_v1_classifications__namespace___classification_type___classification_code__members_get",
        "parameters": [
          {
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "maxLength": 50,
              "minLength": 1,
              "title": "Namespace",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "classification_type",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ClassificationType"
            }
          },
          {
            "in": "path",
            "name": "classification_code",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Classification Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "as_of_date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "As Of Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5000,
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassificationMembersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Classification Members",
        "tags": [
          "market-data"
        ]
      }
